# Copy to .env and fill in. Never commit .env.

# The Switch agent bridge (switch-core API). Leave empty when Switch Console
# runs the server on this computer: Hearth reads the port Console chose from
# %APPDATA%\switchdash\local-switch-server\ports.json ("api", e.g. 64729).
# Check with: curl http://127.0.0.1:<port>/health
SWITCH_BASE_URL=

# A registration key: Switch Console > Settings (bottom left) > API keys >
# Create registration key. Only `hearth-register` uses it. You become the
# owner of the agents it registers. The value is shown once.
SWITCH_REGISTRATION_KEY=

# The LLM behind the companion. Any OpenAI-compatible chat completions API works.
# Default: Google's Gemini API (free key at https://aistudio.google.com/apikey).
HEARTH_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HEARTH_LLM_API_KEY=
# gemini-flash-latest follows Google's current Flash model. To pin one model,
# set it here (gemini-3.8-flash). gemini-2.5-flash is closed to new API keys.
HEARTH_LLM_MODEL=gemini-flash-latest
# Tried in order if the model above is unavailable (404 or "model not found").
# Busy (503/429) or missing models fall through to the next one.
HEARTH_LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-lite-latest,gemini-2.5-flash

# Voice notes. Leave these empty to transcribe with Gemini (same key as above).
# Or use any OpenAI-compatible /audio/transcriptions endpoint, for example
# Groq: HEARTH_STT_BASE_URL=https://api.groq.com/openai/v1, HEARTH_STT_MODEL=whisper-large-v3-turbo
# OpenAI: HEARTH_STT_BASE_URL=https://api.openai.com/v1, HEARTH_STT_MODEL=whisper-1
HEARTH_STT_BASE_URL=
HEARTH_STT_API_KEY=
HEARTH_STT_MODEL=

# Which companion this laptop runs: hearth-companion-a or hearth-companion-b.
HEARTH_COMPANION_NAME=hearth-companion-a

# 1 = short timers for recording the demo (pages re-route after ~45 seconds).
HEARTH_DEMO=0

# Path to the family config. Defaults to config/hearth.yaml.
HEARTH_CONFIG=config/hearth.yaml
